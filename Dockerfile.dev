FROM node:22-bookworm

WORKDIR /app

# Instala dependências de sistema
RUN apt-get update && apt-get install -y git openssh-client

# Instala o Next.js globalmente no container
RUN npm install -g next

# Desabilita assinatura de commits via Git (evita o erro "signature helper")
RUN git config --global commit.gpgsign false \
    && git config --global init.defaultBranch main

# Evita warning de "dubious ownership" quando o workspace é montado
RUN git config --global --add safe.directory /app

# Define a porta da aplicação (deve coincidir com o EXPOSE e o forwardPorts do devcontainer)
ENV PORT=4200

# Copia arquivos de configuração do projeto
COPY package*.json ./
COPY tsconfig.json ./

# Instala dependências (--no-frozen-lockfile permite atualizações no lock)
RUN npm install --no-frozen-lockfile

# Copia o restante do código
COPY . .

EXPOSE 4200
CMD ["npm", "run", "dev"]
{
  "name": "psn-trophy-analyser",
  "version": "1.0.0",
  "description": "PSN Trophy Analysis Platform with FusionAuth",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "docker:dev": "docker-compose up --build",
    "docker:prod": "docker build -t psn-analyser . && docker run -p 3000:3000 psn-analyser",
    "docker:down": "docker-compose down",
    "db:init": "tsx scripts/init-db.ts",
    "db:health": "tsx scripts/check-health.ts",
    "db:cleanup": "tsx scripts/cleanup-analyses.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "daisyui": "^5.5.14",
    "date-fns": "^4.1.0",
    "idb": "^8.0.0",
    "lucide-react": "^1.28.0",
    "mongodb": "^7.0.0",
    "next": "^16.0.10",
    "postcss-cli": "^11.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.5.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.23",
    "baseline-browser-mapping": "^2.10.0",
    "chart.js": "^4.4.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.0.10",
    "postcss": "^8.5.6",
    "react-chartjs-2": "^5.3.0",
    "typescript": "^5.9.3",
    "workbox-cli": "^7.0.0"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  },
  "browserslist": "> 1%",
  "allowScripts": {
    "spawn-sync@1.0.15": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
